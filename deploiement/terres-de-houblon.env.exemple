# /etc/terres-de-houblon.env (root:houblon, 640)
HOST=127.0.0.1
PORT=3210
DB_PATH=/var/lib/terres-de-houblon/parties.sqlite
ALLOWED_ORIGINS=https://jeu.leperelamer.fr
PUBLIC_URL=https://jeu.leperelamer.fr/
# Notifications e-mail des parties en différé (clé API Brevo dédiée au jeu ; sans clé, rien n'est envoyé)
BREVO_API_KEY=
MAIL_FROM=jeu@leperelamer.fr
